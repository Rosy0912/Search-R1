+ assert [r['sha256'] for r in records if r['sha256']]==['f9558df91d3b89b4826e4db37439edb52f1d62a4fd602685013e7ca6b9f60f8f','51410930d5cf19a998fdb17ef0c46e4d9ace72c97a975a3331395a8a500f5edb']
