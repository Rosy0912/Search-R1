         actual_cold_native_state_equal=True, adam_steps=adam_steps,
-        scheduler_step=worker.actor_lr_scheduler.last_epoch, actual_total_optimizer_calls=40,
+        scheduler_step=worker.actor_lr_scheduler.last_epoch,
