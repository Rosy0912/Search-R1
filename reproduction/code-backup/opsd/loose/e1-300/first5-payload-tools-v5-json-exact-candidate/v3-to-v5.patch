+
+def teacher_report_projection(value):
+    """Exact writer JSON semantics; reject key collisions and nonfinite values."""
+    def convert(item):
+        if type(item) is dict:
+            out={}
+            for key,child in item.items():
+                require(type(key) in (str,int),'unsupported teacher report key type')
+                canonical_key=str(key)
+                require(canonical_key not in out,'teacher report JSON key collision')
+                out[canonical_key]=convert(child)
+            return out
+        if type(item) in (tuple,list):return [convert(child) for child in item]
+        require(item is None or type(item) in (str,int,float,bool),'unsupported teacher report value type')
+        if type(item) is float:require(math.isfinite(item),'nonfinite teacher report value')
+        return item
+    # The explicit projection checks collisions BEFORE JSON could overwrite a
+    # distinct Python key. Every field/value is retained; buffers remain covered
+    # independently by the full native state digest and buffer checks.
+    return unique(json.dumps(convert(value),sort_keys=True,allow_nan=False))
+
+def teacher_report_exact(raw, report):
+    def canonical(value):
+        return json.dumps(teacher_report_projection(value),sort_keys=True,separators=(',',':'),allow_nan=False)
+    # Python equality aliases True/1 and 1/1.0. Actual writer JSON retains their
+    # types, so compare exact finite canonical JSON representations instead.
+    return canonical(raw)==canonical(report)
 
