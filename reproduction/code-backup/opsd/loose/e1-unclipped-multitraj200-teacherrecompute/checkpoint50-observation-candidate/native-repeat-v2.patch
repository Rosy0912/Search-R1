+def native_repeat_frame(line,marker,gate,warnings,original_error):
+    """Remove only one typed native Ray tag; the frozen gate checks all remainder.
+
+    This external transport adapter does not alter original bytes, expand repeated
+    tags into ranks, or accept a warning that the original gate rejects.
+    Live collect() independently checks each fixed worker's original start and UID0.
+    """
+    need(marker=='FULL_STATE_RANK_JSON=' and str(original_error)=='Unrecognized/unowned interleaved warning suffix',
+         'Only the known native repeat boundary may use the external adapter')
+    prefix,raw=line.split(marker,1)
+    transport=re.fullmatch(r'\x1b\[36m\(WorkerDict pid=([1-9][0-9]*)\)\x1b\[0m ',prefix)
+    need(transport is not None,'Exact coloured native worker prefix required')
+    body_start=len(raw)-len(raw.lstrip());value,end=json.JSONDecoder().raw_decode(raw.lstrip())
+    need(type(value) is dict,'Native repeat object required')
+    need(type(value.get('version')) is int and value['version']==3 and value.get('algorithm')=='pure_opsd'
+         and value.get('status')=='FULL_STATE_SERIALIZED_OK','Typed periodic serialized report required')
+    rank=value.get('rank');pid=value.get('pid');step=value.get('step')
+    need(type(rank) is int and rank in WORKERS and type(pid) is int and pid==WORKERS[rank][0]
+         and pid==int(transport.group(1)) and type(step) is int and step in (50,100)
+         and type(value.get('world_size')) is int and value['world_size']==8,'Native repeat rank/PID/world/step differs')
+    boundary=body_start+end;suffix=raw[boundary:]
+    repeat=re.match(r'\x1b\[32m \[repeated ([1-8])x across cluster\]\x1b\[0m',suffix)
+    need(repeat is not None,'Exact coloured Ray repeat1..8 tag required')
+    tag=repeat.group(0);remainder=suffix[repeat.end():]
+    clean=prefix+marker+raw[:boundary]+remainder
+    checked=gate.parse_log_marker(clean,marker,driver_pid=DRIVER[0],job_id='3304',worker_pids=tuple(x[0] for x in WORKERS.values()),
+        checkpoint_warning_path=TORCH_ROOT/'utils/checkpoint.py',fsdp_warning_source_bytes=warnings)
+    # Validate the same original body with the original strict JSON decoder.
+    same(checked,value,'Delegated native body differs')
+    proof=dict(kind='EXACT_TYPED_NATIVE_RAY_REPEAT_FRAME',repeated_count=int(repeat.group(1)),rank=rank,pid=pid,step=step,
+        tag_offset_in_line=len((prefix+marker+raw[:boundary]).encode()),tag_bytes=len(tag.encode()),tag_sha256=sha(tag.encode()),
+        tag_base64=base64.b64encode(tag.encode()).decode(),remaining_suffix_bytes=len(remainder.encode()),remaining_suffix_sha256=sha(remainder.encode()),
+        delegated_parser_sha256=GATE_SHA,original_parser_error=str(original_error),
+        scope='ONE_VISIBLE_ORIGINAL_RANK_ONLY_NO_HIDDEN_RANK_EXPANSION_REMAINDER_CHECKED_BY_UNCHANGED_GATE')
+    return checked,proof
+
