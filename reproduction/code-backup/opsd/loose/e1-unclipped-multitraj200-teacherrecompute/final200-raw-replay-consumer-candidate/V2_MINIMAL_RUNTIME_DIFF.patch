+@contextmanager
+def derived_stream(path):
+    """Persist even an incomplete derived prefix before propagating its failure."""
+    with Path(path).open('xb') as stream:
+        try:
+            yield stream
+        finally:
+            stream.flush(); os.fsync(stream.fileno())
+            fd = os.open(Path(path).parent, os.O_RDONLY)
+            try:
+                os.fsync(fd)
+            finally:
+                os.close(fd)
+
