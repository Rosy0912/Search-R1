+def transfer(argv, authority, out, err, start_path):
+    process, waited, returncode, local_pid, input_complete = None, False, None, None, False
+    errors = []
+    try:
+        process = subprocess.Popen(argv, stdin=subprocess.PIPE, stdout=out, stderr=err)
+        local_pid = process.pid
+        save(start_path, (json.dumps(dict(local_ssh_pid=local_pid,
+             popen_returned_utc=datetime.datetime.now(datetime.timezone.utc).isoformat())) + '\n').encode())
+        process.stdin.write(authority)
+        process.stdin.close()
+        input_complete = True
+    except Exception as error:
+        errors.append(dict(stage='start_or_send', type=type(error).__name__, detail=str(error)))
+    finally:
+        if process is not None:
+            try:
+                if not process.stdin.closed:
+                    process.stdin.close()
+            except Exception as error:
+                errors.append(dict(stage='close_stdin', type=type(error).__name__, detail=str(error)))
+            deadline = time.monotonic() + 600
+            while time.monotonic() < deadline:
+                try:
+                    returncode = process.wait(timeout=min(30, max(.001, deadline - time.monotonic())))
+                    waited = True
+                    break
+                except subprocess.TimeoutExpired:
+                    pass
+                except Exception as error:
+                    errors.append(dict(stage='wait', type=type(error).__name__, detail=str(error)))
+                    break
+    return dict(waited=waited, returncode=returncode, local_ssh_pid=local_pid,
+                authority_input_complete=input_complete, local_errors=errors)
+
