+def raw_upper(inventory):
+    """Original whole USTAR bytes: two EOF blocks, then 20-block record padding."""
+    members = sum(512 + ((row['bytes'] + 511) // 512) * 512 for row in inventory['files'])
+    return ((members + 1024 + 10239) // 10240) * 10240
+
