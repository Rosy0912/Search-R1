+DIRECT_SSH = ['/usr/bin/ssh','-B','en0','-oProxyCommand=none','-oProxyJump=none',
+              '-oControlMaster=no','-S','none','-oBatchMode=yes','-oConnectTimeout=10','hkust1']
+
